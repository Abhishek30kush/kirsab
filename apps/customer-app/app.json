{
  "expo": {
    "name": "KIRSAB - Fresh Groceries",
    "slug": "kirsab-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#176B3A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.kirsab.customer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#176B3A"
      },
      "package": "in.kirsab.customer",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CALL_PHONE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "kirsab-customer-app"
      }
    }
  }
}

