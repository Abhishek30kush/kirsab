// KIRSAB PostgreSQL Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model Category {
  id           String    @id
  nameHi       String
  nameEn       String
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id            String      @id
  nameEn        String
  nameHi        String
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  unit          String      // e.g. "1 kg", "500 g", "100 g", "1 bunch", "1 piece"
  unitHindi     String      // e.g. "प्रति किलो", "प्रति 500 ग्राम"
  unitShort     String      // e.g. "kg", "500g", "100g", "bunch", "pc"
  price         Float?      // Configurable price (null means unconfigured / unavailable)
  isConfigured  Boolean     @default(false)
  inStock       Boolean     @default(true)
  isActive      Boolean     @default(true)
  stockQuantity Int         @default(100)
  badge         String?
  description   String?
  image         String
  fallbackEmoji String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orderItems          OrderItem[]
  pricingCalculations PricingCalculation[]
  competitorPrices    CompetitorPrice[]
  offers              OfferProduct[]

  @@index([categoryId])
  @@index([inStock, isConfigured, isActive])
}

model PricingCalculation {
  id                         String   @id @default(cuid())
  productId                  String?
  product                    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName                String
  supplierName               String?
  purchaseDate               DateTime @default(now())
  unit                       String   @default("1 kg")

  // Purchase inputs
  purchasePricePerKg         Float
  purchasedQuantity          Float
  invoiceAmount              Float?
  loadingUnloadingCost       Float    @default(0)
  transportCost              Float    @default(0)
  otherProcurementCost       Float    @default(0)

  // Wastage inputs
  wastagePercentage          Float    @default(0)
  actualWastageQty           Float?

  // Additional costs
  packagingCostPerKg         Float    @default(0)
  packagingCostPerOrder      Float    @default(0)
  avgOrderSizeKg             Float    @default(2.5)
  handlingLabourCost         Float    @default(0)
  isLaborPerKg               Boolean  @default(false)
  storageElectricityCost     Float    @default(0)
  platformOperatingCost      Float    @default(0)
  gatewayFeePercent          Float    @default(0)
  otherExpenses              Float    @default(0)
  deliveryMode               String   @default("free") // free, customer_paid, subsidized
  deliverySubsidizedCost     Float    @default(0)

  // Pricing mode & targets
  pricingMode                String   @default("margin") // margin, profit_per_kg
  targetMargin               Float    @default(20)
  targetProfitPerKg          Float    @default(0)
  roundingRule               String   @default("exact")

  // Calculated outputs
  totalProcurementCost       Float
  usableQuantity             Float
  effectivePurchaseCostPerKg Float
  totalBatchCost             Float
  totalUnitCost              Float
  unroundedSellingPrice      Float
  recommendedSellingPrice    Float
  expectedProfitPerKg        Float
  expectedGrossProfit        Float
  grossMarginPercent         Float
  breakEvenSellingPrice      Float

  appliedToProduct           Boolean  @default(false)
  appliedAt                  DateTime?
  notes                      String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  competitorPrices           CompetitorPrice[]

  @@index([productId])
  @@index([createdAt])
}

model CompetitorPrice {
  id                   String              @id @default(cuid())
  productId            String?
  product              Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  pricingCalculationId String?
  pricingCalculation   PricingCalculation? @relation(fields: [pricingCalculationId], references: [id], onDelete: Cascade)
  competitorName       String              // Blinkit, Zepto, Flipkart Minutes, Local Mandi / Other
  packQuantity         Float               @default(1)
  packUnit             String              @default("kg")
  packPrice            Float
  normalizedPricePerKg Float
  cityPincode          String              @default("211011")
  notes                String?
  checkedAt            DateTime            @default(now())
  createdAt            DateTime            @default(now())

  @@index([productId])
  @@index([competitorName])
  @@index([checkedAt])
}

model StoreSettings {
  id                     String   @id @default("default")
  brandName              String   @default("KIRSAB")
  brandNameHindi         String   @default("किरसाब")
  tagline                String   @default("सब्ज़ी | किराना | घर तक")
  taglineEnglish         String   @default("Vegetables | Grocery | Direct to your Doorstep")
  whatsappNumber         String   @default("918858922873")
  serviceAreaPrimary     String   @default("Shervani Legacy")
  serviceAreaCity        String   @default("Prayagraj")
  serviceAreaState       String   @default("Uttar Pradesh")
  serviceAreaPincode     String   @default("211011")
  serviceAreaDescription String   @default("वर्तमान में केवल शेरवानी लेगेसी (Shervani Legacy) एवं आसपास के चयनित फ्लैट्स के लिए उपलब्ध।")
  minOrderValue          Float    @default(150)
  standardDeliveryFee    Float    @default(10)
  freeDeliveryThreshold  Float    @default(299)
  isStoreOpen            Boolean  @default(true)
  deliverySlotsJson      String   @default("[{\"id\":\"morning\",\"label\":\"सुबह का स्लॉट (Morning)\",\"time\":\"07:00 AM - 10:00 AM\",\"note\":\"ताज़ा सुबह स्टॉक\"},{\"id\":\"evening\",\"label\":\"शाम का स्लॉट (Evening)\",\"time\":\"05:00 PM - 08:00 PM\",\"note\":\"शाम के भोजन हेतु\"}]")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique // e.g. KIR-2026-1001
  customerName         String
  customerPhone        String
  address              String
  landmark             String?
  deliverySlot         String
  instructions         String?
  subtotal             Float
  discountTotal        Float       @default(0)
  deliveryFee          Float
  finalTotal           Float
  status               String      @default("pending") // pending, confirmed, preparing, ready_for_dispatch, out_for_delivery, delivered, cancelled
  paymentMethod        String      @default("cod")
  paymentStatus        String      @default("pending")
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  items                OrderItem[]
  statusHistory        OrderStatusHistory[]

  // Customer link (nullable for guest checkout)
  customerId           String?
  customerUser         User?       @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)

  // Delivery Partner assignment
  deliveryPartnerId    String?
  deliveryPartner      User?       @relation("DeliveryPartnerOrders", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  assignedAt           DateTime?
  acceptedAt           DateTime?
  pickedUpAt           DateTime?
  outForDeliveryAt     DateTime?
  deliveredAt          DateTime?

  // Secure Delivery PIN fields (Module 4)
  deliveryPinHash      String?     // Keyed HMAC-SHA256 hash for secure constant-time verification
  deliveryPinEncrypted String?     // AES-256-GCM encrypted for authenticated customer viewing
  pinGeneratedAt       DateTime?
  pinConsumedAt        DateTime?
  pinFailedAttempts    Int         @default(0)
  pinMaxAttempts       Int         @default(5)
  pinLockedUntil       DateTime?

  // Delivery verification and assignment audit logs
  verificationAudits   DeliveryVerificationAudit[]

  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([deliveryPartnerId])
}

model User {
  id                   String                      @id @default(cuid())
  phone                String?                     @unique
  email                String?                     @unique
  name                 String
  passwordHash         String
  role                 String                      @default("customer") // customer, delivery_partner, admin
  isActive             Boolean                     @default(true)
  vehicleType          String?                     // For delivery partner: bike, scooter, cycle
  vehicleNumber        String?                     // For delivery partner
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  addresses            CustomerAddress[]
  orders               Order[]                     @relation("CustomerOrders")
  assignedDeliveries   Order[]                     @relation("DeliveryPartnerOrders")
  auditActions         DeliveryVerificationAudit[]

  @@index([phone])
  @@index([email])
  @@index([role, isActive])
}

model CustomerAddress {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label                String   @default("Home") // Home, Work, Other
  flatNumber           String   // Tower & Flat / House No
  street               String   // Street / Society name
  locality             String   @default("Shervani Legacy")
  city                 String   @default("Prayagraj")
  state                String   @default("Uttar Pradesh")
  pincode              String   @default("211011")
  landmark             String?
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

model DeliveryVerificationAudit {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId    String?
  partner      User?    @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  actionType   String   // pin_verified, pin_failed, pin_locked, order_assigned, order_reassigned, order_accepted, order_picked_up, order_out_for_delivery
  success      Boolean
  attemptCount Int      @default(0)
  notes        String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([partnerId])
  @@index([actionType])
  @@index([createdAt])
}

model OrderStatusHistory {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus String?
  newStatus      String
  changedBy      String    @default("system")
  notes          String?
  createdAt      DateTime  @default(now())

  @@index([orderId])
  @@index([createdAt])
  @@index([newStatus])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameEn     String   // Immutable snapshot
  productNameHi     String   // Immutable snapshot
  unit              String   // Immutable snapshot
  unitPrice         Float    // Immutable snapshot: final unit price after discount
  originalUnitPrice Float?   // Immutable snapshot: original master unit price before discount
  discountPerUnit   Float    @default(0) // Discount amount per unit
  discountAmount    Float    @default(0) // Total discount amount applied to this line item (discountPerUnit * quantity)
  offerId           String?
  offer             Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  offerTitle        String?  // Snapshot of offer name/title
  quantity          Int
  lineTotal         Float    // final unitPrice * quantity

  @@index([orderId])
  @@index([offerId])
}

model Offer {
  id            String         @id @default(cuid())
  title         String         // e.g. "Weekend Fresh Green Sale", "₹10 Off Potatoes"
  description   String?        // Optional promotional tagline or details
  discountType  String         // "percentage" | "fixed"
  discountValue Float          // Percentage (e.g. 20 for 20%) or Fixed amount (e.g. 15 for ₹15/unit)
  startDate     DateTime       // Offer start timestamp
  endDate       DateTime       // Offer expiry timestamp
  isActive      Boolean        @default(true) // Admin activation toggle
  minQuantity   Int?           // Optional minimum quantity required to qualify
  maxDiscount   Float?         // Optional maximum cap on total discount per item
  usageLimit    Int?           // Optional maximum usage limit across all orders
  usageCount    Int            @default(0) // Total orders in which this offer has been used
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  products      OfferProduct[]
  orderItems    OrderItem[]

  @@index([isActive, startDate, endDate])
  @@index([createdAt])
}

model OfferProduct {
  id        String   @id @default(cuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([offerId, productId])
  @@index([productId])
  @@index([offerId])
}

