// KIRSAB PostgreSQL Prisma Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model Category {
  id           String    @id
  nameHi       String
  nameEn       String
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Product {
  id            String      @id
  nameEn        String
  nameHi        String
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  unit          String      // e.g. "1 kg", "500 g", "100 g", "1 bunch", "1 piece"
  unitHindi     String      // e.g. "प्रति किलो", "प्रति 500 ग्राम"
  unitShort     String      // e.g. "kg", "500g", "100g", "bunch", "pc"
  price         Float?      // Configurable price (null means unconfigured / unavailable)
  isConfigured  Boolean     @default(false)
  inStock       Boolean     @default(true)
  isActive      Boolean     @default(true)
  stockQuantity Int         @default(100)
  badge         String?
  description   String?
  image         String
  fallbackEmoji String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orderItems          OrderItem[]
  pricingCalculations PricingCalculation[]
  competitorPrices    CompetitorPrice[]

  @@index([categoryId])
  @@index([inStock, isConfigured, isActive])
}

model PricingCalculation {
  id                         String   @id @default(cuid())
  productId                  String?
  product                    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName                String
  supplierName               String?
  purchaseDate               DateTime @default(now())
  unit                       String   @default("1 kg")

  // Purchase inputs
  purchasePricePerKg         Float
  purchasedQuantity          Float
  invoiceAmount              Float?
  loadingUnloadingCost       Float    @default(0)
  transportCost              Float    @default(0)
  otherProcurementCost       Float    @default(0)

  // Wastage inputs
  wastagePercentage          Float    @default(0)
  actualWastageQty           Float?

  // Additional costs
  packagingCostPerKg         Float    @default(0)
  packagingCostPerOrder      Float    @default(0)
  avgOrderSizeKg             Float    @default(2.5)
  handlingLabourCost         Float    @default(0)
  isLaborPerKg               Boolean  @default(false)
  storageElectricityCost     Float    @default(0)
  platformOperatingCost      Float    @default(0)
  gatewayFeePercent          Float    @default(0)
  otherExpenses              Float    @default(0)
  deliveryMode               String   @default("free") // free, customer_paid, subsidized
  deliverySubsidizedCost     Float    @default(0)

  // Pricing mode & targets
  pricingMode                String   @default("margin") // margin, profit_per_kg
  targetMargin               Float    @default(20)
  targetProfitPerKg          Float    @default(0)
  roundingRule               String   @default("exact")

  // Calculated outputs
  totalProcurementCost       Float
  usableQuantity             Float
  effectivePurchaseCostPerKg Float
  totalBatchCost             Float
  totalUnitCost              Float
  unroundedSellingPrice      Float
  recommendedSellingPrice    Float
  expectedProfitPerKg        Float
  expectedGrossProfit        Float
  grossMarginPercent         Float
  breakEvenSellingPrice      Float

  appliedToProduct           Boolean  @default(false)
  appliedAt                  DateTime?
  notes                      String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  competitorPrices           CompetitorPrice[]

  @@index([productId])
  @@index([createdAt])
}

model CompetitorPrice {
  id                   String              @id @default(cuid())
  productId            String?
  product              Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  pricingCalculationId String?
  pricingCalculation   PricingCalculation? @relation(fields: [pricingCalculationId], references: [id], onDelete: Cascade)
  competitorName       String              // Blinkit, Zepto, Flipkart Minutes, Local Mandi / Other
  packQuantity         Float               @default(1)
  packUnit             String              @default("kg")
  packPrice            Float
  normalizedPricePerKg Float
  cityPincode          String              @default("211011")
  notes                String?
  checkedAt            DateTime            @default(now())
  createdAt            DateTime            @default(now())

  @@index([productId])
  @@index([competitorName])
  @@index([checkedAt])
}

model StoreSettings {
  id                     String   @id @default("default")
  brandName              String   @default("KIRSAB")
  brandNameHindi         String   @default("किरसाब")
  tagline                String   @default("सब्ज़ी | किराना | घर तक")
  taglineEnglish         String   @default("Vegetables | Grocery | Direct to your Doorstep")
  whatsappNumber         String   @default("918808481400")
  serviceAreaPrimary     String   @default("Shervani Legacy")
  serviceAreaCity        String   @default("Prayagraj")
  serviceAreaState       String   @default("Uttar Pradesh")
  serviceAreaPincode     String   @default("211011")
  serviceAreaDescription String   @default("वर्तमान में केवल शेरवानी लेगेसी (Shervani Legacy) एवं आसपास के चयनित फ्लैट्स के लिए उपलब्ध।")
  minOrderValue          Float    @default(150)
  standardDeliveryFee    Float    @default(10)
  freeDeliveryThreshold  Float    @default(299)
  isStoreOpen            Boolean  @default(true)
  deliverySlotsJson      String   @default("[{\"id\":\"morning\",\"label\":\"सुबह का स्लॉट (Morning)\",\"time\":\"07:00 AM - 10:00 AM\",\"note\":\"ताज़ा सुबह स्टॉक\"},{\"id\":\"evening\",\"label\":\"शाम का स्लॉट (Evening)\",\"time\":\"05:00 PM - 08:00 PM\",\"note\":\"शाम के भोजन हेतु\"}]")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique // e.g. KIR-2026-1001
  customerName   String
  customerPhone  String
  address        String
  landmark       String?
  deliverySlot   String
  instructions   String?
  subtotal       Float
  deliveryFee    Float
  finalTotal     Float
  status         String      @default("pending") // pending, confirmed, packed, out_for_delivery, delivered, cancelled
  paymentMethod  String      @default("cod")
  paymentStatus  String      @default("pending")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]

  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameEn String   // Immutable snapshot
  productNameHi String   // Immutable snapshot
  unit          String   // Immutable snapshot
  unitPrice     Float    // Immutable snapshot
  quantity      Int
  lineTotal     Float

  @@index([orderId])
}
